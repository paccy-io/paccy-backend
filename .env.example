# Application Configuration
APP_NAME=Paccy
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_LOGGING_LEVEL=debug

# Discord Webhook for Comprehensive Application Monitoring (optional)
# Get this from Discord Server Settings > Integrations > Webhooks
# This will send real-time notifications for:
# - 🚨 Error/Fatal log alerts automatically
# - 🚀 Startup notifications when the app is deployed/restarted
# - 👤 User registration notifications for new sign-ups
# - 📧 Email verification notifications when users verify emails
# - 📨 Email delivery notifications (success and failure) for every email sent
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=3000

# Database Configuration
DATABASE_URI=mongodb://localhost:27017
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin
DATABASE_NAME=paccy

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_here
JWT_EXPIRES_IN=28800
JWT_ISSUER=paccy

# Password Hashing Configuration (Argon2ID)
HASHING_ALGORITHM=argon2id
HASHING_MEMORY=65536
HASHING_ITERATIONS=3
HASHING_PARALLELISM=1
HASHING_SALT_LENGTH=16
HASHING_KEY_LENGTH=32

# Email Provider Configuration
NOTIFY_ADMIN_RESENDER_API_KEY=your_resender_api_key
NOTIFY_ADMIN_RESENDER_FROM=no-reply@paccy.io

NOTIFY_ADMIN_GMAIL_SMTP_USERNAME=your_gmail@gmail.com
NOTIFY_ADMIN_GMAIL_SMTP_PASSWORD=your_app_password
NOTIFY_ADMIN_GMAIL_SMTP_FROM=no-reply@paccy.io
NOTIFY_ADMIN_GMAIL_SMTP_HOST=smtp.gmail.com
NOTIFY_ADMIN_GMAIL_SMTP_PORT=465

# Notification Quotas
NOTIFY_PROJECT_NAME=paccy
NOTIFY_RESENDER_DAILY_QUOTA=100
NOTIFY_RESENDER_MONTHLY_QUOTA=3000
NOTIFY_GMAIL_SMTP_DAILY_QUOTA=450
NOTIFY_GMAIL_SMTP_MONTHLY_QUOTA=13950

# User Quotas
NOTIFY_USER_AUTH_QUOTA=2
NOTIFY_USER_SECURITY_QUOTA=1
NOTIFY_USER_NOTIFICATION_QUOTA=0
